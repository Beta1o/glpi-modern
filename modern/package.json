{
  "name": "glpi-modern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modern GLPI service foundation for a faster, safer, horizontally scalable rewrite.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "node --experimental-strip-types --check src/server.ts && node --experimental-strip-types --check src/store.ts"
  }
}
